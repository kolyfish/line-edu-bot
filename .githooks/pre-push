#!/usr/bin/env bash
# 防漏第二道：push 前把「這次要推的所有 commit」再掃一次
# 原因: 有人會用 git commit --no-verify 跳過 pre-commit，push 是最後關卡
set -u
cd "$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
values=$(.githooks/_secret_values.sh)
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi

  if git log -p "$range" | grep -qE '^\+\+\+ b/(.*/)?\.env$'; then
    echo "❌ 擋下：要推送的 commit 裡含 .env 檔"; fail=1
  fi
  if [ -n "$values" ] && git log -p "$range" | grep -qF -f <(printf '%s\n' "$values"); then
    echo "❌ 擋下：要推送的 commit 歷史含有真實金鑰"; fail=1
  fi
  if command -v gitleaks >/dev/null; then
    gitleaks git --log-opts="$range" --redact --no-banner -c .gitleaks.toml . >/dev/null 2>&1 \
      || { echo "❌ 擋下：gitleaks 在 commit 歷史找到疑似金鑰"; fail=1; }
  fi
done

[ $fail -eq 0 ] || { echo "🛑 push 已取消。金鑰已進 commit 歷史，需改寫歷史並【撤銷該金鑰重發】"; exit 1; }
