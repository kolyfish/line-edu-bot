#!/usr/bin/env bash
# 防漏第一道：commit 前擋住金鑰
set -u
cd "$(git rev-parse --show-toplevel)"
fail=0

# 1. 不准 commit 任何 .env 檔（.env.example 除外）
bad_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$')
if [ -n "$bad_files" ]; then
  echo "❌ 擋下：不能 commit 金鑰檔 → $bad_files"
  echo "   解除暫存：git restore --staged $bad_files"
  fail=1
fi

# 2. 暫存內容不能出現 .env 裡的真實金鑰值（不印出值本身）
values=$(.githooks/_secret_values.sh)
if [ -n "$values" ] && git diff --cached -U0 | grep -qF -f <(printf '%s\n' "$values"); then
  echo "❌ 擋下：暫存的檔案內容含有 .env 裡的真實金鑰"
  git diff --cached --name-only | while read -r f; do
    git show ":$f" 2>/dev/null | grep -qF -f <(printf '%s\n' "$values") && echo "   → $f"
  done
  fail=1
fi

# 3. gitleaks 掃描（內建 + LINE 規則）
if command -v gitleaks >/dev/null; then
  gitleaks git --pre-commit --staged --redact --no-banner -c .gitleaks.toml . >/dev/null 2>&1 || {
    echo "❌ 擋下：gitleaks 偵測到疑似金鑰，執行以下指令看細節（已遮蔽）："
    echo "   gitleaks git --pre-commit --staged --redact -c .gitleaks.toml ."
    fail=1
  }
else
  echo "⚠️  沒裝 gitleaks，只做了基本檢查：brew install gitleaks"
fi

[ $fail -eq 0 ] || { echo "🛑 commit 已取消"; exit 1; }
